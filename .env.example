# === LLM providers ===
ANTHROPIC_API_KEY=sk-ant-...
MODEL_OVERRIDE=                        # e.g. claude-opus-4-7; leave blank for default

# === Search ===
TAVILY_API_KEY=tvly-...

# === Observability / tracing ===
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=news-mas
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# === Local model inference ===
OLLAMA_BASE_URL=http://localhost:11434

# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/news_mas

# === Security (development only — replaced by DPoP in production) ===
# [DPOP-TODO] Remove MAS_SECRET_KEY once DPoPAuthMiddleware is active on all agents.
MAS_SECRET_KEY=change-me-in-production

# === Microsoft Entra ID / DPoP (production A2A authentication) ===
# One app registration per agent — see DPOP_IMPLEMENTATION_GUIDE.md §3.1
# Entra ref: https://learn.microsoft.com/en-us/entra/identity-platform/v2-oauth2-auth-code-flow
ENTRA_TENANT_ID=                                  # Entra tenant GUID or domain

AGENT_SEARCH_WORKER_CLIENT_ID=
AGENT_SEARCH_WORKER_CLIENT_SECRET=
AGENT_SEARCH_WORKER_SCOPES=                       # comma-separated; typically left empty (calls external)

AGENT_HEAT_SCORER_CLIENT_ID=
AGENT_HEAT_SCORER_CLIENT_SECRET=
AGENT_HEAT_SCORER_SCOPES=                         # api://<phase1_judge_client_id>/.default

AGENT_FILTER_AGENT_CLIENT_ID=
AGENT_FILTER_AGENT_CLIENT_SECRET=
AGENT_FILTER_AGENT_SCOPES=

AGENT_SELECTOR_CLIENT_ID=
AGENT_SELECTOR_CLIENT_SECRET=
AGENT_SELECTOR_SCOPES=

AGENT_PHASE1_JUDGE_CLIENT_ID=
AGENT_PHASE1_JUDGE_CLIENT_SECRET=
AGENT_PHASE1_JUDGE_SCOPES=

AGENT_SUMMARIZER_CLIENT_ID=
AGENT_SUMMARIZER_CLIENT_SECRET=
AGENT_SUMMARIZER_SCOPES=

AGENT_REVIEWER_CLIENT_ID=
AGENT_REVIEWER_CLIENT_SECRET=
AGENT_REVIEWER_SCOPES=

AGENT_RELEVANCE_GATE_CLIENT_ID=
AGENT_RELEVANCE_GATE_CLIENT_SECRET=
AGENT_RELEVANCE_GATE_SCOPES=

# [DPOP-TODO] DPoP private key location per agent.
# Azure-hosted: leave blank and load from Key Vault via Managed Identity.
# Cross-cloud (AWS/GCP): set to the PEM file mount path.
# See DPOP_IMPLEMENTATION_GUIDE.md §3.4.
# AGENT_{NAME}_DPOP_KEY_PATH=

# === Run behaviour ===
MAX_TOPICS=10
MAX_RETRIES=3
MAX_TOKENS_PER_RUN=200000
TOKEN_BUDGET_SOURCES=200000
SINCE_DATE_DEFAULT_DAYS=7

# === Runtime ===
ENVIRONMENT=development              # development | staging | production
LOG_LEVEL=INFO
