# ── Bootstrap (required by every agent) ──────────────────────────────────────
# These are the only variables an agent needs to start. Everything else
# (model, capabilities, token_budget, prompt_version) comes from the registry.

WORKLOAD_IDENTITY_PROVIDER=local
# Selects the platform identity provider. One of:
#   local                  — shared-secret only (dev/test, NOT FOR PRODUCTION)
#   azure-managed-identity — Azure IMDS + Entra federation
#   aws-sts                — AWS STS OIDC + Entra federation
#   gcp-workload           — GCP metadata server + Entra OIDC federation
# See [WORKLOAD-IDENTITY-TODO] in src/auth/workload_identity.py for each guide.

REGISTRY_URL=http://localhost:8000
# URL of the agent registry server. Agents call GET /agents/{id}/config here
# at startup to fetch their AgentConfig. In production this resolves to the
# private DNS name of the registry service in the mas-identity subnet.

# [DPOP-TODO] Remove MAS_SECRET_KEY once DPoPAuthMiddleware is active on all agents.
# In production this is replaced by platform-issued Managed Identity tokens.
# See DPOP_IMPLEMENTATION_GUIDE.md §3.1.
MAS_SECRET_KEY=local-dev-only

AGENT_ID=
# Set per-agent. Must match the agent_id seeded in the registry.
# Examples: search-worker, heat-scorer, summarizer, reviewer, relevance-gate
# In docker-compose, set via environment: AGENT_ID=search-worker per service.

SERVICE_PORT=8001
# The port this agent binds to. Set per-agent in docker-compose.
# Ports: search-worker=8001, heat-scorer=8002, filter-agent=8003,
#        selector=8004, phase1-judge=8005, summarizer=8006,
#        reviewer=8007, relevance-gate=8008, registry=8000

ENVIRONMENT=local-dev
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# Service name sent as resource attribute to OTel collector and Jaeger.
# Set per-agent in docker-compose; falls back to the agent module name.
# Values: news-mas-auth-server, news-mas-registry, news-mas-orchestrator-1,
#         news-mas-orchestrator-2, news-mas-search-worker, news-mas-heat-scorer,
#         news-mas-filter-agent, news-mas-selector, news-mas-phase1-judge,
#         news-mas-summarizer, news-mas-reviewer, news-mas-relevance-gate
SERVICE_NAME=news-mas-search-worker
SERVICE_VERSION=0.1.0

# ── External API credentials ──────────────────────────────────────────────────
# External API credentials — not agent identity.
# In production these live in Azure Key Vault, accessed via Managed Identity
# at runtime. They are NOT part of agent bootstrap and are not fetched from
# the registry; each agent reads only what it needs directly from the environment.

# search-worker only
TAVILY_API_KEY=tvly-...

# summarizer and reviewer only
ANTHROPIC_API_KEY=sk-ant-...

# ── Observability ──────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=news-mas-dev
LANGCHAIN_PROJECT=news-mas-dev

# ── Local model inference ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Storage ───────────────────────────────────────────────────────────────────
FERNET_KEY=                          # Generate with: python scripts/generate_key.py
DATA_DIR=./data/

# ── Microsoft Entra ID / DPoP (production A2A auth — deferred) ───────────────
# One Entra app registration per agent once DPoP is active.
# See DPOP_IMPLEMENTATION_GUIDE.md §3.1 and ARCHITECTURE.md §4.
ENTRA_TENANT_ID=

AGENT_SEARCH_WORKER_CLIENT_ID=
AGENT_SEARCH_WORKER_CLIENT_SECRET=
AGENT_HEAT_SCORER_CLIENT_ID=
AGENT_HEAT_SCORER_CLIENT_SECRET=
AGENT_FILTER_AGENT_CLIENT_ID=
AGENT_FILTER_AGENT_CLIENT_SECRET=
AGENT_SELECTOR_CLIENT_ID=
AGENT_SELECTOR_CLIENT_SECRET=
AGENT_PHASE1_JUDGE_CLIENT_ID=
AGENT_PHASE1_JUDGE_CLIENT_SECRET=
AGENT_SUMMARIZER_CLIENT_ID=
AGENT_SUMMARIZER_CLIENT_SECRET=
AGENT_REVIEWER_CLIENT_ID=
AGENT_REVIEWER_CLIENT_SECRET=
AGENT_RELEVANCE_GATE_CLIENT_ID=
AGENT_RELEVANCE_GATE_CLIENT_SECRET=

# [DPOP-TODO] DPoP private key location per agent.
# Azure-hosted: leave blank — loaded from Key Vault via Managed Identity.
# Cross-cloud: set to PEM file mount path. See DPOP_IMPLEMENTATION_GUIDE.md §3.4.
# AGENT_{NAME}_DPOP_KEY_PATH=

# ── Run behaviour ─────────────────────────────────────────────────────────────
# Note: model assignment, token_budget, and prompt_version are now set in the
# registry (src/registry/registry_server.py seed data), not here.
MAX_TOPICS=10
MAX_RETRIES=3
SINCE_DATE_DEFAULT_DAYS=7

# Token budgets for the Phase 1 orchestrator.
#
# LLM token budget — gates actual LLM API calls (heat scorer, filter, selector,
# judge).  Exceeding this aborts the run with run_status=budget_exceeded.
# MAX_LLM_TOKENS_PER_RUN takes precedence; MAX_TOKENS_PER_RUN is the fallback.
MAX_LLM_TOKENS_PER_RUN=500000
MAX_TOKENS_PER_RUN=500000
#
# Content token budget — Tavily raw_content and search result bodies.  These are
# input tokens (much cheaper than LLM output tokens) tracked for observability
# only; the run is never aborted for exceeding this limit.
MAX_CONTENT_TOKENS_PER_RUN=2000000
#
# Per-topic content cap — articles for a single topic are truncated when their
# combined content exceeds this limit, preventing one noisy topic from crowding
# out the others (cybersecurity topics can exceed 70k tokens of raw content alone).
MAX_CONTENT_TOKENS_PER_TOPIC=100000

# Maximum number of concurrent Anthropic API calls in Phase 2.
# Keeps parallel summarizer/reviewer calls within Sonnet rate limits.
# Raise to 3–4 on Tier-3+ accounts; lower to 1 if you see sustained 429s.
MAX_PARALLEL_SUMMARIZERS=2

# ── Content injection detection ───────────────────────────────────────────────
# Probability threshold for the ML-based ContentInjectionDetector (DeBERTa model).
# Higher = less sensitive, fewer false positives on security/SQL/XSS articles.
# Lower = more sensitive, may flag edge cases or ambiguous phrasing.
INJECTION_DETECTION_THRESHOLD=0.85

# Set to false to route agent calls over HTTP (production A2A path).
# Default: true (in-process imports for local dev and unit tests).
# See [A2A-TODO] in src/orchestrators/phase1/registry_client.py.
USE_LOCAL_AGENTS=true

# ── Tavily search configuration ───────────────────────────────────────────────
# search_depth controls how deeply Tavily crawls. "advanced" returns better
# raw_content extraction; "basic" is faster with less content.
TAVILY_SEARCH_DEPTH=advanced

# ── Model override ────────────────────────────────────────────────────────────
# Model override for local development
# Empty = use registry defaults (Gemma 4 local)
# claude-haiku = fast iteration (~60s pipeline)
# claude-sonnet-4-6 = test summarizer quality
# gemma4:e4b = force local inference
# Summarizer and reviewer are always exempt from this override.
MODEL_OVERRIDE=claude-haiku-4-5-20251001

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Triggers scheduled pipeline runs. The scheduler service exposes a management
# API on port 8010. Topics are read from the topic repository at run time.

# Standard cron expression for the pipeline trigger.
# Default: Monday at 08:00 Mountain time. Leave blank if using SCHEDULE_INTERVAL_HOURS.
SCHEDULE_CRON=0 8 * * 1

# Alternative to SCHEDULE_CRON: run every N hours.
# When set, SCHEDULE_CRON is ignored.
SCHEDULE_INTERVAL_HOURS=

# Set to false to disable automatic scheduled runs (manual trigger via API still works).
SCHEDULE_ENABLED=true

# IANA timezone for SCHEDULE_CRON interpretation.
SCHEDULE_TIMEZONE=America/Denver

# How many days back to look for articles in each pipeline run.
# SINCE_DATE_DEFAULT_DAYS is also used by the orchestrators; it is listed here
# again to make the scheduler's dependency on it explicit.
# SINCE_DATE_DEFAULT_DAYS=7  (already set above under Run behaviour)
